# 复制为 .env 后填入你支付宝开放平台沙箱应用信息
# 沙箱地址：https://open.alipay.com/develop/sandbox/app
PORT=3001
# 沙箱网关固定
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 你的沙箱 AppID（16位数字）
ALIPAY_APP_ID=90210001406xxxxx
# 用 alipay-sdk 官方工具生成的 应用私钥（PKCS8，带 -----BEGIN PRIVATE KEY----- 头尾）
ALIPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIBIjANBgkqh...你的私钥...\n-----END PRIVATE KEY-----"
# 支付宝公钥（不是应用公钥，在沙箱应用详情-接口加签方式-查看支付宝公钥 复制）
ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqh...支付宝公钥...\n-----END PUBLIC KEY-----"
# 同步回跳（WebView 拦截 pay/return 解析 payResult）
ALIPAY_RETURN_URL=http://127.0.0.1:3001/pay/return
# 异步通知（板机上 nat/内网穿透后需改公网地址）
ALIPAY_NOTIFY_URL=http://127.0.0.1:3001/api/pay/notify
