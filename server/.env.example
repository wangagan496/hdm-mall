HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/mall.sqlite
UPLOADS_PATH=./data/uploads
PUBLIC_URL=http://127.0.0.1:3000
MOCK_PAYMENTS=true
NODE_ENV=development
# Required when a production payment channel is configured.
PAYMENT_CALLBACK_SECRET=
# Explicit CORS allowlist in every environment; no wildcard.
# Include null only when packaged ArkWeb/rawfile H5 access is needed (also in production).
# Production logs a warning when null is allowed; Bearer token authentication is still required.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
# Empty means no trusted proxy. Set only actual proxy IPs/CIDRs, never true, hop counts or /0.
TRUSTED_PROXIES=
# Optional first-run merchant account; no default password is provided.
MERCHANT_ACCOUNT=
MERCHANT_PASSWORD=
