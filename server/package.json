{
  "name": "hdm-mall-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "backup": "node src/backup-cli.ts create",
    "backup:verify": "node src/backup-cli.ts verify",
    "restore": "node src/backup-cli.ts restore"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.0"
  }
}
