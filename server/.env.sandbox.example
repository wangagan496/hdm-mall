# 仅供填写说明；真实配置和密钥保存在仓库外，不能提交或回传。
# 复制到本人目录的 .hdm-sandbox/server.env 后由本人填写。
# development；production 禁止支付宝沙箱。
NODE_ENV=
# mock 或 alipay-sandbox；沙箱时 MOCK_PAYMENTS 必须 false。
PAYMENT_CHANNEL=
MOCK_PAYMENTS=
# mock 或 kdniao；kdniao 需本人先确认1002权限、额度与有效期。
LOGISTICS_CHANNEL=
# 本机监听地址、端口以及设备可访问的服务来源地址。
HOST=
PORT=
PUBLIC_URL=
# 沙箱使用独立数据库和上传目录，勿复用历史mock支付数据。
DATABASE_PATH=
UPLOADS_PATH=
# 显式来源白名单；现有打包H5需要时包含null。
CORS_ORIGINS=
# 以下每组直接值和_FILE二选一；优先填写仓库外文件的绝对路径。
# 沙箱应用APPID，16位数字。
ALIPAY_APP_ID=
ALIPAY_APP_ID_FILE=
# 沙箱卖家支付宝UID，16位数字；不是买家账号。
ALIPAY_SELLER_ID=
ALIPAY_SELLER_ID_FILE=
# 本应用RSA2私钥，完整PEM；不是支付宝公钥。
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_FILE=
# 沙箱控制台对应的支付宝公钥，完整PEM；不是应用公钥。
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_FILE=
# 可选；公网HTTPS且路径必须/payments/alipay/notify；本机留空，用主动查单。
ALIPAY_NOTIFY_URL=
# 快递鸟账号ID与AppKey；每组直接值和_FILE二选一。
KDNIAO_BUSINESS_ID=
KDNIAO_BUSINESS_ID_FILE=
KDNIAO_APP_KEY=
KDNIAO_APP_KEY_FILE=
# 首次启动的商家账号与密码由本人填写，不发送到聊天。
MERCHANT_ACCOUNT=
MERCHANT_PASSWORD=
