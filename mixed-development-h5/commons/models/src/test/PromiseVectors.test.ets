    it('stage2b-snapshot', 0, () => { expect(parsePromiseSnapshot("{\"receiptId\":\"receipt-1\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"publishedAt\":1763452800000,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}]}") !== null).assertEqual(true) })
