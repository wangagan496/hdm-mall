// 生成文件勿手改；与 Node/TS 共用 contract-kit/v1/vectors/promises.ts
import { describe, it, expect } from '@ohos/hypium'
import { parsePromiseEntry, parsePromiseSourceRef, parsePromiseDraft, parsePromiseSnapshot, parsePromiseTemplateField } from '../main/ets/Promises'
export default function promisesVectorTests(): void {
  describe('promisesContractVectors', () => {
    it('known-with-origin', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1}") !== null).assertEqual(true) })
    it('known-with-qualifier-warning', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1,\"conditionNeedsReview\":true}") !== null).assertEqual(true) })
    it('quality-return-suggestion', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"material\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1,\"suggestedAfterSaleKind\":\"return-quality\"}") !== null).assertEqual(true) })
    it('invalid-return-suggestion', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1,\"suggestedAfterSaleKind\":\"refund-missing\"}") !== null).assertEqual(false) })
    it('unknown-with-null-value', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}") !== null).assertEqual(true) })
    it('not-applicable', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"not-applicable\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}") !== null).assertEqual(true) })
    it('unknown-field-id', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"injected\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1}") !== null).assertEqual(false) })
    it('unknown-unit', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"分钟数\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1}") !== null).assertEqual(false) })
    it('unknown-state', 0, () => { expect(parsePromiseEntry("{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"confirmed\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1}") !== null).assertEqual(false) })
    it('unknown-source-field', 0, () => { expect(parsePromiseSourceRef("{\"field\":\"foreign\",\"start\":0,\"end\":5}") !== null).assertEqual(false) })
    it('source-ref-negative-offset', 0, () => { expect(parsePromiseSourceRef("{\"field\":\"description\",\"start\":-1,\"end\":5}") !== null).assertEqual(false) })
    it('source-ref-fractional-offset', 0, () => { expect(parsePromiseSourceRef("{\"field\":\"description\",\"start\":0.5,\"end\":5}") !== null).assertEqual(false) })
    it('draft', 0, () => { expect(parsePromiseDraft("{\"id\":\"draft-1\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}],\"issues\":[]}") !== null).assertEqual(true) })
    it('draft-extra-key', 0, () => { expect(parsePromiseDraft("{\"id\":\"draft-1\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}],\"issues\":[],\"secret\":\"not-a-contract-field\"}") !== null).assertEqual(false) })
    it('draft-nested-invalid', 0, () => { expect(parsePromiseDraft("{\"id\":\"draft-1\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":0}],\"issues\":[]}") !== null).assertEqual(false) })
    it('snapshot', 0, () => { expect(parsePromiseSnapshot("{\"receiptId\":\"receipt-1\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"publishedAt\":1763452800000,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}]}") !== null).assertEqual(true) })
    it('legacy-snapshot-retains-original-entry-shape', 0, () => { expect(parsePromiseSnapshot("{\"receiptId\":\"receipt-1\",\"templateVersion\":\"promises-20261118-1\",\"productRevision\":1,\"publishedAt\":1763452800000,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}]}") !== null).assertEqual(true) })
    it('snapshot-missing-receipt', 0, () => { expect(parsePromiseSnapshot("{\"receiptId\":\"\",\"templateVersion\":\"promises-20261118-2\",\"productRevision\":1,\"publishedAt\":1763452800000,\"entries\":[{\"fieldId\":\"dispatch-window\",\"label\":\"发货时效\",\"status\":\"known\",\"value\":\"48\",\"unit\":\"小时\",\"condition\":null,\"quote\":\"48小时发货\",\"sourceRef\":{\"field\":\"description\",\"start\":0,\"end\":5},\"sourceRevision\":1},{\"fieldId\":\"origin\",\"label\":\"产地\",\"status\":\"unknown\",\"value\":null,\"unit\":null,\"condition\":null,\"quote\":null,\"sourceRef\":null,\"sourceRevision\":null}]}") !== null).assertEqual(false) })
    it('catalog-template', 0, () => { expect(parsePromiseTemplateField("{\"id\":\"shoe-sole\",\"label\":\"鞋底材质\",\"valueType\":\"text\",\"units\":[],\"categories\":[\"鞋靴\"],\"suggestedAfterSaleKind\":\"return-quality\"}") !== null).assertEqual(true) })
    it('catalog-template-invalid-type', 0, () => { expect(parsePromiseTemplateField("{\"id\":\"shoe-sole\",\"label\":\"鞋底材质\",\"valueType\":\"arbitrary\",\"units\":[],\"categories\":[\"鞋靴\"]}") !== null).assertEqual(false) })
  })
}
