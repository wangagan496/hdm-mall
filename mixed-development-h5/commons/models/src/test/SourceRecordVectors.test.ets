    it('verified-without-basis', 0, () => { expect(parseSourceRecord("{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"verified\",\"availability\":\"applicable\",\"verifier\":\"处理员\",\"verifiedAt\":1,\"basis\":null}") !== null).assertEqual(false) })
    it('pending-with-verifier', 0, () => { expect(parseSourceRecord("{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":\"店主\",\"verifiedAt\":null,\"basis\":null}") !== null).assertEqual(false) })
    it('invalid-version', 0, () => { expect(parseSourceRecord("{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":0,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null}") !== null).assertEqual(false) })
    it('invalid-state', 0, () => { expect(parseSourceRecord("{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"authentic\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null}") !== null).assertEqual(false) })
    it('no-attachment', 0, () => { expect(parseSourceRecord("{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null,\"attachment\":\"file\"}") !== null).assertEqual(false) })
    it('frozen-and-current', 0, () => { expect(parsePromiseMaterialSource("{\"fieldId\":\"material-composition\",\"record\":{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null},\"currentAvailability\":\"withdrawn\"}") !== null).assertEqual(true) })
    it('invalid-current', 0, () => { expect(parsePromiseMaterialSource("{\"fieldId\":\"material-composition\",\"record\":{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null},\"currentAvailability\":\"verified\"}") !== null).assertEqual(false) })
    it('invalid-nested-record', 0, () => { expect(parsePromiseMaterialSource("{\"fieldId\":\"material-composition\",\"record\":{\"materialId\":\"record-1\",\"kind\":\"inspection-report\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null},\"currentAvailability\":\"withdrawn\"}") !== null).assertEqual(false) })
