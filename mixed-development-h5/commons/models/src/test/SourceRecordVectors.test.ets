    it('unknown-type', 0, () => { expect(parseProductMaterials("{\"batch\":\"B-24\",\"materials\":[{\"materialId\":\"record-1\",\"kind\":\"invoice\",\"version\":1,\"productId\":\"product-1\",\"productName\":\"纯棉短袜\",\"batch\":\"B-24\",\"validFrom\":1,\"validUntil\":2,\"summary\":\"材料说明：纯棉短袜。\",\"verificationStatus\":\"pending\",\"availability\":\"applicable\",\"verifier\":null,\"verifiedAt\":null,\"basis\":null}]}") !== null).assertEqual(false) })
  })
