// 生成文件勿手改；与 Node/TS 共用 contract-kit/v1/vectors/spending-guard.ts
import { describe, it, expect } from '@ohos/hypium'
import { parseSpendingRule, parseSpendingRuleInput, parseSpendingSummary, parseSpendingPauseDetail, parseWishlistItem, parseWishlistConfirmInput } from '../main/ets/SpendingGuardModels'
export default function spendingGuardVectorTests(): void {
  describe('spendingGuardContractVectors', () => {
    it('validRule', 0, () => { expect(parseSpendingRule("{\"id\":\"rule-1\",\"version\":1,\"monthlyBudgetCents\":200000,\"perOrderLimitCents\":100000,\"cooldownThresholdCents\":50000,\"cooldownHours\":24,\"enabled\":true,\"monthDisclosure\":\"按北京时间自然月计算，本月已付计已花，待付/待确认计在途占额；同月成功退款回补当月额度，跨月退款不回补上月额度。\",\"createdAt\":1700000000000}") !== null).assertEqual(true) })
    it('disabledDefaultRule', 0, () => { expect(parseSpendingRule("{\"id\":null,\"version\":0,\"monthlyBudgetCents\":null,\"perOrderLimitCents\":null,\"cooldownThresholdCents\":null,\"cooldownHours\":null,\"enabled\":false,\"monthDisclosure\":\"按北京时间自然月计算，本月已付计已花，待付/待确认计在途占额；同月成功退款回补当月额度，跨月退款不回补上月额度。\",\"createdAt\":1700000000000}") !== null).assertEqual(true) })
    it('badCooldownHoursOver72Rejected', 0, () => { expect(parseSpendingRule("{\"id\":\"rule-1\",\"version\":1,\"monthlyBudgetCents\":200000,\"perOrderLimitCents\":100000,\"cooldownThresholdCents\":50000,\"cooldownHours\":73,\"enabled\":true,\"monthDisclosure\":\"按北京时间自然月计算，本月已付计已花，待付/待确认计在途占额；同月成功退款回补当月额度，跨月退款不回补上月额度。\",\"createdAt\":1700000000000}") !== null).assertEqual(false) })
    it('validRuleInput', 0, () => { expect(parseSpendingRuleInput("{\"requestKey\":\"req-rule-1\",\"expectedVersion\":0,\"monthlyBudgetCents\":200000,\"perOrderLimitCents\":100000,\"cooldownThresholdCents\":50000,\"cooldownHours\":24,\"enabled\":true,\"disclosureAccepted\":true}") !== null).assertEqual(true) })
    it('zeroBudgetInputRejected', 0, () => { expect(parseSpendingRuleInput("{\"requestKey\":\"req-rule-1\",\"expectedVersion\":0,\"monthlyBudgetCents\":0,\"perOrderLimitCents\":100000,\"cooldownThresholdCents\":50000,\"cooldownHours\":24,\"enabled\":true,\"disclosureAccepted\":true}") !== null).assertEqual(false) })
    it('validSummary', 0, () => { expect(parseSpendingSummary("{\"monthKey\":\"2026-11\",\"ruleVersion\":1,\"enabled\":true,\"monthlyBudgetCents\":200000,\"perOrderLimitCents\":100000,\"cooldownThresholdCents\":50000,\"cooldownHours\":24,\"spentCents\":30000,\"reservedCents\":10000,\"remainingBudgetCents\":160000,\"waitingWishlistCount\":1,\"monthDisclosure\":\"按北京时间自然月计算，本月已付计已花，待付/待确认计在途占额；同月成功退款回补当月额度，跨月退款不回补上月额度。\"}") !== null).assertEqual(true) })
    it('validPauseMonthly', 0, () => { expect(parseSpendingPauseDetail("{\"limitType\":\"monthly_budget\",\"amountCents\":170000,\"limitCents\":200000,\"ruleVersion\":1,\"monthKey\":\"2026-11\",\"spentCents\":30000,\"reservedCents\":10000,\"remainingBudgetCents\":160000}") !== null).assertEqual(true) })
    it('invalidLimitTypeRejected', 0, () => { expect(parseSpendingPauseDetail("{\"limitType\":\"daily_budget\",\"amountCents\":170000,\"limitCents\":200000,\"ruleVersion\":1,\"monthKey\":\"2026-11\",\"spentCents\":30000,\"reservedCents\":10000,\"remainingBudgetCents\":160000}") !== null).assertEqual(false) })
    it('validWishlistItem', 0, () => { expect(parseWishlistItem("{\"id\":\"wish-1\",\"requestKey\":\"req-wish-1\",\"status\":\"waiting\",\"goods\":[{\"skuId\":\"sku-1\",\"productId\":\"prod-1\",\"name\":\"真皮托特包\",\"spec\":\"黑色大号\",\"picture\":\"/assets/bag.jpg\",\"unitPriceCents\":60000,\"count\":1}],\"addressId\":\"addr-1\",\"expectedAmountCents\":60000,\"quotedTotalCents\":60000,\"currentQuotedTotalCents\":60000,\"priceChanged\":false,\"promotionRevision\":1,\"ruleVersion\":1,\"cooldownUntil\":1700086400000,\"readyToConfirm\":false,\"createdAt\":1700000000000}") !== null).assertEqual(true) })
    it('emptyGoodsWishlistRejected', 0, () => { expect(parseWishlistItem("{\"id\":\"wish-1\",\"requestKey\":\"req-wish-1\",\"status\":\"waiting\",\"goods\":[],\"addressId\":\"addr-1\",\"expectedAmountCents\":60000,\"quotedTotalCents\":60000,\"currentQuotedTotalCents\":60000,\"priceChanged\":false,\"promotionRevision\":1,\"ruleVersion\":1,\"cooldownUntil\":1700086400000,\"readyToConfirm\":false,\"createdAt\":1700000000000}") !== null).assertEqual(false) })
    it('validWishlistConfirmInput', 0, () => { expect(parseWishlistConfirmInput("{\"requestKey\":\"req-conf-1\",\"expectedAmountCents\":60000}") !== null).assertEqual(true) })
    it('validWishlistConfirmWithPolicyToken', 0, () => { expect(parseWishlistConfirmInput("{\"requestKey\":\"req-conf-2\",\"expectedAmountCents\":60000,\"returnPolicyConfirmed\":true,\"expectedReturnPolicyToken\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}") !== null).assertEqual(true) })
    it('badWishlistConfirmTokenLengthRejected', 0, () => { expect(parseWishlistConfirmInput("{\"requestKey\":\"req-conf-3\",\"expectedAmountCents\":60000,\"returnPolicyConfirmed\":true,\"expectedReturnPolicyToken\":\"short\"}") !== null).assertEqual(false) })
    it('zeroConfirmAmountRejected', 0, () => { expect(parseWishlistConfirmInput("{\"requestKey\":\"req-conf-1\",\"expectedAmountCents\":0}") !== null).assertEqual(false) })
  })
}
