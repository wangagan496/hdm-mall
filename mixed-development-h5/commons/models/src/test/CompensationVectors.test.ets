// 生成文件勿手改；与 Node/TS 共用 contract-kit/v1/vectors/compensation.ts
import { describe, it, expect } from '@ohos/hypium'
import { parseCompensationDraftBrief, parseCompensationConfirmInput, parseCompensationReceipt } from '../main/ets/CompensationModels'
export default function compensationVectorTests(): void {
  describe('compensationContractVectors', () => {
    it('validDraftBrief', 0, () => { expect(parseCompensationDraftBrief("{\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"budgetPerOrderCents\":1000,\"basketDeltaCents\":500,\"cappedCents\":500,\"perLine\":[{\"order_line_id\":\"sku-1\",\"delta_cents\":500}],\"createdAt\":1700000000000,\"expiresAt\":1700172800000,\"status\":\"pending\"}") !== null).assertEqual(true) })
    it('pendingBudgetDraft', 0, () => { expect(parseCompensationDraftBrief("{\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"budgetPerOrderCents\":1000,\"basketDeltaCents\":500,\"cappedCents\":500,\"perLine\":[{\"order_line_id\":\"sku-1\",\"delta_cents\":500}],\"createdAt\":1700000000000,\"expiresAt\":1700172800000,\"status\":\"pending_budget\"}") !== null).assertEqual(true) })
    it('zeroCappedDraftRejected', 0, () => { expect(parseCompensationDraftBrief("{\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"budgetPerOrderCents\":1000,\"basketDeltaCents\":500,\"cappedCents\":0,\"perLine\":[{\"order_line_id\":\"sku-1\",\"delta_cents\":500}],\"createdAt\":1700000000000,\"expiresAt\":1700172800000,\"status\":\"pending\"}") !== null).assertEqual(false) })
    it('emptyPerLineRejected', 0, () => { expect(parseCompensationDraftBrief("{\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"budgetPerOrderCents\":1000,\"basketDeltaCents\":500,\"cappedCents\":500,\"perLine\":[],\"createdAt\":1700000000000,\"expiresAt\":1700172800000,\"status\":\"pending\"}") !== null).assertEqual(false) })
    it('validConfirmInput', 0, () => { expect(parseCompensationConfirmInput("{\"draftId\":\"draft-1\",\"requestKey\":\"req-1\",\"confirmedCents\":500}") !== null).assertEqual(true) })
    it('zeroConfirmCentsRejected', 0, () => { expect(parseCompensationConfirmInput("{\"draftId\":\"draft-1\",\"requestKey\":\"req-1\",\"confirmedCents\":0}") !== null).assertEqual(false) })
    it('validPendingReceipt', 0, () => { expect(parseCompensationReceipt("{\"receiptId\":\"receipt-1\",\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"confirmedCents\":500,\"confirmedAt\":1700001000000,\"channelStatus\":\"pending\",\"channelRef\":null,\"statusLabel\":\"补差已登记，渠道处理中\"}") !== null).assertEqual(true) })
    it('validUnknownReceipt', 0, () => { expect(parseCompensationReceipt("{\"receiptId\":\"receipt-1\",\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"confirmedCents\":500,\"confirmedAt\":1700001000000,\"channelStatus\":\"unknown\",\"channelRef\":null,\"statusLabel\":\"待执行（渠道结果待核实）\"}") !== null).assertEqual(true) })
    it('invalidChannelStatusRejected', 0, () => { expect(parseCompensationReceipt("{\"receiptId\":\"receipt-1\",\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"confirmedCents\":500,\"confirmedAt\":1700001000000,\"channelStatus\":\"settled\",\"channelRef\":null,\"statusLabel\":\"补差已登记，渠道处理中\"}") !== null).assertEqual(false) })
    it('extraFieldReceiptRejected', 0, () => { expect(parseCompensationReceipt("{\"receiptId\":\"receipt-1\",\"draftId\":\"draft-1\",\"orderId\":\"order-1\",\"policyId\":\"policy-1\",\"policyVersion\":1,\"windowDays\":7,\"confirmedCents\":500,\"confirmedAt\":1700001000000,\"channelStatus\":\"pending\",\"channelRef\":null,\"statusLabel\":\"补差已登记，渠道处理中\",\"extra\":1}") !== null).assertEqual(false) })
  })
}
